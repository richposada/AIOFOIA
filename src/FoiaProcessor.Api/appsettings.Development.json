{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.EntityFrameworkCore.Update": "Debug",
      "Microsoft.EntityFrameworkCore.ChangeTracking": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Update": "Debug",
        "Microsoft.EntityFrameworkCore.ChangeTracking": "Debug"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "FoiaDb": "Server=(localdb)\\MSSQLLocalDB;Database=Foia;Trusted_Connection=True;TrustServerCertificate=True"
  },
  
  "Workflow": {
    "MaxSearchResults": 3
  }
}
