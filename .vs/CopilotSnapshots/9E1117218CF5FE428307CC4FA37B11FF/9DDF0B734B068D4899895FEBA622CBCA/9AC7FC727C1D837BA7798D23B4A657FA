using Azure;
using Azure.Search.Documents;
using Azure.Search.Documents.Models;
using FoiaProcessor.McpTools.Contracts;
using FoiaProcessor.McpTools.Options;
using Microsoft.Extensions.Options;

namespace FoiaProcessor.McpTools.Servers;

/// <summary>
/// Search server: thin wrapper over Azure AI Search. Field names are
/// resolved from <see cref="AzureSearchOptions.Fields"/> so the PoC can
/// connect to a pre-existing index with arbitrary schema.
/// </summary>
public class SearchServer
{
    private readonly AzureSearchOptions _opts;
    private readonly SearchClient _client;
    private readonly ILogger<SearchServer> _logger;

    public SearchServer(IOptions<AzureSearchOptions> opts, ILogger<SearchServer> logger)
    {
        _opts = opts.Value;
        _logger = logger;
        var endpoint = new Uri(_opts.Endpoint);
        _client = string.IsNullOrEmpty(_opts.ApiKey)
            ? new SearchClient(endpoint, _opts.IndexName, new Azure.Identity.DefaultAzureCredential())
            : new SearchClient(endpoint, _opts.IndexName, new AzureKeyCredential(_opts.ApiKey));
    }

    public virtual async Task<SearchDocumentsOutput> SearchDocumentsAsync(SearchDocumentsInput input, CancellationToken ct = default)
    {
        var top = input.Top ?? 10;
        var options = new SearchOptions
        {
            Size = top,
            IncludeTotalCount = true,
            QueryType = SearchQueryType.Semantic,
            SemanticSearch = new SemanticSearchOptions
            {
                SemanticConfigurationName = _opts.SemanticConfigurationName, // add to options
                QueryCaption = new(QueryCaptionType.Extractive),
            },
            VectorSearch = new VectorSearchOptions
            {
                Queries =
                {
                    new VectorizableTextQuery(input.Query)
                    {
                        KNearestNeighborsCount = top,
                        Fields = { _opts.Fields.ContentVector }, // e.g. "text_vector"
                    }
                }
            },
        };

        // Make sure the text/content field comes back even if it's not in the default select
        options.Select.Add(_opts.Fields.Id);
        options.Select.Add(_opts.Fields.Content);          // make this point to the TEXT field, e.g. "chunk"
        if (_opts.Fields.FileName  is { } fn) options.Select.Add(fn);
        if (_opts.Fields.FileType  is { } ft) options.Select.Add(ft);
        if (_opts.Fields.SourceUri is { } su) options.Select.Add(su);

        var response = await _client.SearchAsync<SearchDocument>(input.Query, options, ct);
        var total = response.Value.TotalCount;
        // TODO: ILogger – log total, query, index name, and the first id, to confirm what came back.

        var results = new List<SearchResultItem>();
        await foreach (var r in response.Value.GetResultsAsync())
        {
            var mapped = MapResult(r.Document);
            if (mapped is not null) results.Add(mapped);
        }
        return new SearchDocumentsOutput(results);
    }

    public virtual async Task<SearchResultItem?> GetDocumentByIdAsync(GetDocumentByIdInput input, CancellationToken ct = default)
    {
        try
        {
            var resp = await _client.GetDocumentAsync<SearchDocument>(input.Id, cancellationToken: ct);
            return MapResult(resp.Value);
        }
        catch (RequestFailedException ex) when (ex.Status == 404)
        {
            return null;
        }
    }

    public virtual async Task<GetDocumentContentOutput> GetDocumentContentAsync(GetDocumentByIdInput input, CancellationToken ct = default)
    {
        var resp = await _client.GetDocumentAsync<SearchDocument>(input.Id, cancellationToken: ct);
        var content = resp.Value.TryGetValue(_opts.Fields.Content, out var c) ? c?.ToString() ?? string.Empty : string.Empty;
        return new GetDocumentContentOutput(input.Id, content);
    }

    public virtual async Task<SearchDocumentsOutput> SearchDocumentsByDateRangeAsync(SearchByDateRangeInput input, CancellationToken ct = default)
    {
        var options = new SearchOptions
        {
            Size = input.Top ?? 10,
            Filter = $"{_opts.Fields.DocumentDate} ge {input.StartDate:yyyy-MM-dd}T00:00:00Z and {_opts.Fields.DocumentDate} le {input.EndDate:yyyy-MM-dd}T23:59:59Z",
        };
        var response = await _client.SearchAsync<SearchDocument>("*", options, ct);
        var results = new List<SearchResultItem>();
        await foreach (var r in response.Value.GetResultsAsync())
        {
            results.Add(MapResult(r.Document));
        }
        return new SearchDocumentsOutput(results);
    }

    private SearchResultItem? MapResult(SearchDocument doc)
    {
        var f = _opts.Fields;
        string? Get(string? key) => key is not null && doc.TryGetValue(key, out var v) ? v?.ToString() : null;

        var id = Get(f.Id);
        if (string.IsNullOrEmpty(id))
        {
            // Field name mismatch with the index — don't invent a key.
            return null;
        }

        var fileName = Get(f.FileName) ?? $"{id}.txt";
        var fileType = Get(f.FileType) ?? Path.GetExtension(fileName).TrimStart('.').ToLowerInvariant();
        if (string.IsNullOrEmpty(fileType)) fileType = "txt";
        var sourceUri = Get(f.SourceUri);
        var snippet = Get(f.Content);
        if (snippet is { Length: > 240 }) snippet = snippet[..240] + "...";

        return new SearchResultItem(id, fileName, fileName, fileType, sourceUri, null, snippet, null);
    }
}
