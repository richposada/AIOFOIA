using System.ComponentModel;
using FoiaProcessor.Agents.Infrastructure;
using FoiaProcessor.Data;
using FoiaProcessor.Data.Entities;
using FoiaProcessor.McpTools.Contracts;
using FoiaProcessor.McpTools.Options;
using FoiaProcessor.McpTools.Servers;
using Microsoft.Agents.AI;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.AI;
using Microsoft.Extensions.Options;

namespace FoiaProcessor.Agents.Agents;

/// <summary>
/// Agent 5 (Microsoft Agent Framework): Orchestrates the release pipeline
/// (zip → upload → SAS → persist) by exposing each step as an AI function tool
/// that wraps the underlying MCP-shaped servers.
/// </summary>
public class PackagingReleaseAgent
{
    private readonly CaseServer _case;
    private readonly BlobStorageServer _blob;
    private readonly FoiaDbContext _db;
    private readonly AzureBlobStorageOptions _blobOpts;
    private readonly AgentChatClientFactory _chatFactory;

    public PackagingReleaseAgent(
        CaseServer caseServer,
        BlobStorageServer blobServer,
        FoiaDbContext db,
        IOptions<AzureBlobStorageOptions> blobOpts,
        AgentChatClientFactory chatFactory)
    {
        _case = caseServer;
        _blob = blobServer;
        _db = db;
        _blobOpts = blobOpts.Value;
        _chatFactory = chatFactory;
    }

    public virtual async Task RunAsync(Guid requestId, CancellationToken ct = default)
    {
        await _case.CaseUpdateStatusAsync(
            new CaseUpdateStatusInput(requestId, nameof(RequestStatus.Packaging), "Building release package."),
            ct);

        // Carry state across tool calls.
        string? zipBase64 = null;
        string? blobName = null;
        string? sasUrl = null;
        DateTime? sasExpiresAt = null;

        [Description("Build a ZIP archive containing all approved redacted documents for this request.")]
        async Task<string> BuildZip()
        {
            var docs = await _db.Documents
                .AsNoTracking()
                .Where(d => d.FoiaRequestId == requestId && d.ReviewStatus == ReviewStatus.Approved)
                .Select(d => new { d.FileName, Content = d.RedactedContent ?? d.OriginalContent })
                .ToListAsync(ct);

            var entries = docs.Select(d => new ZipFileEntry(d.FileName, d.Content)).ToList();
            var zip = await _blob.CreateZipPackageAsync(new CreateZipPackageInput(requestId, entries), ct);
            zipBase64 = zip.ZipBytesBase64;
            return $"zip built with {entries.Count} document(s)";
        }

        [Description("Upload the previously-built ZIP to blob storage. Call after BuildZip.")]
        async Task<string> UploadZip()
        {
            if (zipBase64 is null) throw new InvalidOperationException("BuildZip must run before UploadZip.");
            blobName = $"{requestId}/release-{DateTime.UtcNow:yyyyMMddHHmmss}.zip";
            await _blob.UploadToBlobStorageAsync(
                new UploadToBlobStorageInput(_blobOpts.ContainerName, blobName, zipBase64, "application/zip"),
                ct);
            return $"uploaded to {blobName}";
        }

        [Description("Generate a time-limited SAS URL for the uploaded ZIP. Call after UploadZip.")]
        async Task<string> GenerateSasUrl()
        {
            if (blobName is null) throw new InvalidOperationException("UploadZip must run before GenerateSasUrl.");
            var sas = await _blob.GenerateSasUrlAsync(
                new GenerateSasUrlInput(_blobOpts.ContainerName, blobName, _blobOpts.SasExpirationDays),
                ct);
            sasUrl = sas.SasUrl;
            sasExpiresAt = sas.ExpiresAt;
            return $"sas valid until {sas.ExpiresAt:O}";
        }

        [Description("Persist the release package metadata against the case and mark the request as ready for release. Call after GenerateSasUrl.")]
        async Task<string> SavePackage()
        {
            if (blobName is null || sasUrl is null || sasExpiresAt is null)
            {
                throw new InvalidOperationException("All preceding steps must run before SavePackage.");
            }

            await _case.CaseSaveReleasePackageAsync(
                new CaseSaveReleasePackageInput(requestId, blobName, _blobOpts.ContainerName, sasUrl, sasExpiresAt.Value),
                ct);
            await _case.CaseUpdateStatusAsync(
                new CaseUpdateStatusInput(requestId, nameof(RequestStatus.ReleasePackageReady), "Release package ready."),
                ct);
            return "release-ready";
        }

        var agent = new ChatClientAgent(
            _chatFactory.ChatClient,
            instructions: """
            You are the Release Packaging agent. Run the release pipeline by calling each tool exactly once in this order:
            1. BuildZip
            2. UploadZip
            3. GenerateSasUrl
            4. SavePackage
            Then stop.
            """,
            name: "ReleasePackager",
            description: null,
            tools: new List<AITool>
            {
                AIFunctionFactory.Create((Delegate)BuildZip),
                AIFunctionFactory.Create((Delegate)UploadZip),
                AIFunctionFactory.Create((Delegate)GenerateSasUrl),
                AIFunctionFactory.Create((Delegate)SavePackage),
            });

        await agent.RunAsync($"Package and release approved documents for request {requestId}.", cancellationToken: ct);
    }
}
